MONGODB_URI=mongodb://127.0.0.1:27017/amethyst?replicaSet=rs0
PORT=4000
APP_ORIGIN=http://localhost:5173
ORGANIZATION=amethyst
ADMIN_NAME=Department Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password

# Jade: Claude Opus reasoning. Keep secrets on the backend only.
ANTHROPIC_API_KEY=
JADE_MODEL=claude-opus-5-5
# Optional salted scrypt override for Jade's owner-selected access password.
JADE_PASSWORD_HASH=
# Operational bound on automatic Manager revision cycles before human feedback.
JADE_MAX_MANAGER_ITERATIONS=3
# Audio/video: optional OpenAI-compatible transcription service (local or HTTPS).
# Jade still uses Claude Opus for all reasoning. Supply the service's actual model ID.
JADE_TRANSCRIPTION_URL=
JADE_TRANSCRIPTION_MODEL=
JADE_TRANSCRIPTION_KEY=
# Optional override if ffmpeg-static is unavailable.
JADE_FFMPEG_PATH=
